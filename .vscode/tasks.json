{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "unity: copy",
            "dependsOn": [
                "unity: copy core",
                "unity: copy excel",
                "unity: copy google",
                "unity: copy csv",
                "unity: copy json"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": [ "$tsc" ]
        },
        {
            "label": "unity: copy core",
            "type": "shell",
            "command": "cp",
            "args": [
                "-R", "BakingSheet/Src/*",
                "UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Core"
            ],
            "problemMatcher": [ "$tsc" ],
        },
        {
            "label": "unity: copy excel",
            "type": "shell",
            "command": "cp",
            "args": [
                "BakingSheet.Converters.Excel/*.cs",
                "UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Converters/Excel"
            ],
            "problemMatcher": [ "$tsc" ],
        },
        {
            "label": "unity: copy google",
            "type": "shell",
            "command": "cp",
            "args": [
                "BakingSheet.Converters.Google/*.cs",
                "UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Converters/Google"
            ],
            "problemMatcher": [ "$tsc" ],
        },
        {
            "label": "unity: copy csv",
            "type": "shell",
            "command": "cp",
            "args": [
                "BakingSheet.Converters.Csv/*.cs",
                "UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Converters/Csv"
            ],
            "problemMatcher": [ "$tsc" ],
        },
        {
            "label": "unity: copy json",
            "type": "shell",
            "command": "cp",
            "args": [
                "BakingSheet.Converters.Json/*.cs",
                "UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Converters/Json"
            ],
            "problemMatcher": [ "$tsc" ],
        },
        {
            "label": "unity: publish",
            "dependsOn": [
                "unity: publish csv"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": [ "$tsc" ]
        },
        {
            "label": "unity: publish csv",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "publish", "-c", "Release",
                "-f", "netstandard2.0",
                "-o", "UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Converters/CSV/Prebuilt",
                "BakingSheet.Converters.Csv"
            ],
            "problemMatcher": [ "$tsc" ],
        },
        {
            "label": "copy md",
            "type": "shell",
            "command": "cp",
            "args": [ "*.md", "UnityProject/Packages/com.laicasaane.bakingsheet/" ],
            "problemMatcher": [ "$tsc" ],
        }
    ]
}
