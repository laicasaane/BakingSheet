{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "unity: copy",
            "dependsOn": [
                "unity: copy core",
                "unity: copy excel",
                "unity: copy google",
                "unity: copy csv",
                "unity: copy json"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": [ "$tsc" ]
        },
        {
            "label": "unity: copy core",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/.vscode/scripts/Sync-UnityFiles.sh",
                "--source", "${workspaceFolder}/BakingSheet/Src",
                "--destination", "${workspaceFolder}/UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Core",
                "--recurse"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile", "-ExecutionPolicy", "Bypass",
                    "-File", "${workspaceFolder}/.vscode/scripts/Sync-UnityFiles.ps1",
                    "-Source", "${workspaceFolder}/BakingSheet/Src",
                    "-Destination", "${workspaceFolder}/UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Core",
                    "-Recurse"
                ]
            },
            "problemMatcher": [ "$tsc" ],
        },
        {
            "label": "unity: copy excel",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/.vscode/scripts/Sync-UnityFiles.sh",
                "--source", "${workspaceFolder}/BakingSheet.Converters.Excel",
                "--destination", "${workspaceFolder}/UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Converters/Excel",
                "--include", "*.cs"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile", "-ExecutionPolicy", "Bypass",
                    "-File", "${workspaceFolder}/.vscode/scripts/Sync-UnityFiles.ps1",
                    "-Source", "${workspaceFolder}/BakingSheet.Converters.Excel",
                    "-Destination", "${workspaceFolder}/UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Converters/Excel",
                    "-Include", "*.cs"
                ]
            },
            "problemMatcher": [ "$tsc" ],
        },
        {
            "label": "unity: copy google",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/.vscode/scripts/Sync-UnityFiles.sh",
                "--source", "${workspaceFolder}/BakingSheet.Converters.Google",
                "--destination", "${workspaceFolder}/UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Converters/Google",
                "--include", "*.cs"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile", "-ExecutionPolicy", "Bypass",
                    "-File", "${workspaceFolder}/.vscode/scripts/Sync-UnityFiles.ps1",
                    "-Source", "${workspaceFolder}/BakingSheet.Converters.Google",
                    "-Destination", "${workspaceFolder}/UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Converters/Google",
                    "-Include", "*.cs"
                ]
            },
            "problemMatcher": [ "$tsc" ],
        },
        {
            "label": "unity: copy csv",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/.vscode/scripts/Sync-UnityFiles.sh",
                "--source", "${workspaceFolder}/BakingSheet.Converters.Csv",
                "--destination", "${workspaceFolder}/UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Converters/Csv",
                "--include", "*.cs"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile", "-ExecutionPolicy", "Bypass",
                    "-File", "${workspaceFolder}/.vscode/scripts/Sync-UnityFiles.ps1",
                    "-Source", "${workspaceFolder}/BakingSheet.Converters.Csv",
                    "-Destination", "${workspaceFolder}/UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Converters/Csv",
                    "-Include", "*.cs"
                ]
            },
            "problemMatcher": [ "$tsc" ],
        },
        {
            "label": "unity: copy json",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/.vscode/scripts/Sync-UnityFiles.sh",
                "--source", "${workspaceFolder}/BakingSheet.Converters.Json",
                "--destination", "${workspaceFolder}/UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Converters/Json",
                "--include", "*.cs"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile", "-ExecutionPolicy", "Bypass",
                    "-File", "${workspaceFolder}/.vscode/scripts/Sync-UnityFiles.ps1",
                    "-Source", "${workspaceFolder}/BakingSheet.Converters.Json",
                    "-Destination", "${workspaceFolder}/UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Converters/Json",
                    "-Include", "*.cs"
                ]
            },
            "problemMatcher": [ "$tsc" ],
        },
        {
            "label": "unity: publish",
            "dependsOn": [
                "unity: publish csv"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": [ "$tsc" ]
        },
        {
            "label": "unity: publish csv",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "publish", "-c", "Release",
                "-f", "netstandard2.0",
                "-o", "UnityProject/Packages/com.laicasaane.bakingsheet/Runtime/Converters/CSV/Prebuilt",
                "BakingSheet.Converters.Csv"
            ],
            "problemMatcher": [ "$tsc" ],
        },
        {
            "label": "copy md",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/.vscode/scripts/Sync-UnityFiles.sh",
                "--source", "${workspaceFolder}",
                "--destination", "${workspaceFolder}/UnityProject/Packages/com.laicasaane.bakingsheet",
                "--include", "CHANGELOG.md|LICENSE.md|LICENSE.Original.md|README.md|Third Party Notices.md"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile", "-ExecutionPolicy", "Bypass",
                    "-File", "${workspaceFolder}/.vscode/scripts/Sync-UnityFiles.ps1",
                    "-Source", "${workspaceFolder}",
                    "-Destination", "${workspaceFolder}/UnityProject/Packages/com.laicasaane.bakingsheet",
                    "-Include", "CHANGELOG.md|LICENSE.md|LICENSE.Original.md|README.md|Third Party Notices.md"
                ]
            },
            "problemMatcher": [ "$tsc" ],
        }
    ]
}
